{
  "name": "3saat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "VITE_DEMO=1 vite",
    "build": "tsc -b && tsc -p tsconfig.worker.json && vite build",
    "preview": "vite preview",
    "build:demo": "tsc -b && VITE_DEMO=1 vite build",
    "worker:dev": "npm run build && wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply 3saat --local",
    "db:migrate": "wrangler d1 migrations apply 3saat --remote",
    "admin:create": "node scripts/create-admin.mjs",
    "deploy": "npm run build && wrangler d1 migrations apply 3saat --remote && wrangler deploy"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "hono": "^4.13.22",
    "lucide-react": "^1.78.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "@tailwindcss/container-queries": "^0.1.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.7.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "wrangler": "^4.168.0"
  }
}